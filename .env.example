# GEMINI_API_KEY: the Gemini key for the server-side AI gateway (server/ai/provider.ts only).
# Never exposed to the browser (no VITE_ prefix; no route returns it).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- AI operating layer (Phase 6 Batch 7; docs/phase6-ai-operating-layer.md) ---
# Server side only; nothing here reaches the browser. Without a provider NW OS shows its own
# record-based answers. AI_PROVIDER: gemini (default when GEMINI_API_KEY is set) | mock | none.
# AI_PROVIDER=""
# AI_MODEL="gemini-flash-latest"
# AI_TIMEOUT_MS=20000
# AI_MAX_RETRIES=1
# AI_MAX_CONTEXT_CHARS=24000
# AI_MAX_REQUESTS_PER_USER_HOUR=40
# AI_MAX_REQUESTS_PER_USER_DAY=200
# AI_RETENTION_DAYS=180

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Core-chain database (Clients -> Projects -> Work Packages -> Work Items) ---
# Optional. Without DATABASE_URL the app keeps all data in browser localStorage.
# Local Postgres: postgres://nwos:nwos@localhost:5432/nwos_dev
# Supabase: Project Settings -> Database -> Connection string (URI). Use the pooler URI.
# With role separation (docs/database-privileges.md) this is the restricted runtime login,
# nwos_app: it owns nothing and cannot alter or disable the database protections. In production
# the server refuses to start if this login is privileged (owner, superuser, CREATEDB, ...).
DATABASE_URL=""

# --- Database role separation (Phase 6 Batch 10; docs/database-privileges.md) ---
# The migrator login (nwos_migrator), used ONLY by `npm run db:migrate` (a release step).
# Never give it to the running server (in production the server refuses to start if it is set).
# Use a direct / session connection: through a transaction pooler SET ROLE does not persist.
# DATABASE_MIGRATION_URL=""
# One-off administrator connection for `npm run db:bootstrap-roles`, with NWOS_MIGRATOR_PASSWORD
# and NWOS_APP_PASSWORD (optional; never printed). Set it only for that command; never in the
# server's environment (in production the server refuses to start if it is set).
# DATABASE_ADMIN_URL=""
# Role and schema names, if not the defaults (three different roles).
# NWOS_DB_OWNER_ROLE="nwos_owner"
# NWOS_DB_MIGRATOR_ROLE="nwos_migrator"
# NWOS_DB_APP_ROLE="nwos_app"
# NWOS_DB_SCHEMA="public"
# Production only, break-glass: with the exact value "true", start even though DATABASE_URL is
# privileged. The database is then NOT hardened; it is logged and audited on every start. Any
# other value is ignored. Leave unset; remove it as soon as the emergency is over.
# NWOS_ALLOW_PRIVILEGED_DATABASE=""

# "database" makes the browser load and save the core chain through the API.
# Anything else (or unset) keeps localStorage as the store.
CORE_DATA_SOURCE="local"

# TLS: auto (default: off for localhost, on otherwise) | disable | require | verify
DATABASE_SSL="auto"
# PEM CA certificate, only for DATABASE_SSL=verify with a private CA.
# DATABASE_CA_CERT=""
# DATABASE_POOL_MAX=10

# Postgres the database tests may create throwaway schemas in (npm test).
# TEST_DATABASE_URL=postgres://nwos:nwos@localhost:5432/nwos_test
# A login that may create roles (superuser / CREATEROLE), for the privilege tests and
# TEST_DB_ROLE_MODE=restricted (the whole suite as a real restricted runtime role). CI sets both.
# TEST_DATABASE_ADMIN_URL=
# TEST_DB_ROLE_MODE=restricted
# Acceptance scripts: the login their fixture SQL uses (default: nwos on PGDATABASE).
# ACCEPTANCE_DATABASE_URL=

# --- Authentication (on whenever DATABASE_URL is set) ---
# Set "true" to mark the session cookie Secure outside NODE_ENV=production (e.g. HTTPS staging).
# COOKIE_SECURE="false"
# Development only: password for `npm run auth:seed-dev` (never set in production).
# DEV_SEED_PASSWORD=""
